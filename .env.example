# TrackVault v2 Environment Configuration

# Runtime environment: development | test | production
NODE_ENV=development

# HTTP bind address and port (use 0.0.0.0 inside containers)
HOST=127.0.0.1
PORT=3010

# Persistent storage directory for SQLite DB, .master.key, and temporary downloads.
# Strongly recommended: point DATA_DIR to a local SSD path (e.g. C:/TrackVaultData or /var/lib/trackvault)
# if running the repository from an SMB/NFS/UNC network share.
DATA_DIR=data

# SQLite journal mode: WAL | TRUNCATE | DELETE (default: WAL).
# Keep WAL on local SSD/disks for concurrent read/write throughput.
# If DATA_DIR must reside on an SMB/NFS network share where -shm mmap locking is unsupported,
# set SQLITE_JOURNAL_MODE=TRUNCATE (pointing DATA_DIR to a local SSD path is strongly preferred).
SQLITE_JOURNAL_MODE=WAL

# Comma-separated browser origins permitted for CORS and CSRF origin validation
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3010,http://127.0.0.1:3010

# Session cookie Secure flag policy: auto | true | false
COOKIE_SECURE=auto

# Reverse proxy hop trust: false | true | <positive integer hop count, e.g. 1>
TRUST_PROXY=false

# Admin session lifetime in days (1..90)
SESSION_TTL_DAYS=14

# Optional 64-char hex key (32 bytes) for AES-256-GCM platform credential encryption.
# If omitted, TrackVault generates a 0600 key at ${DATA_DIR}/.master.key on first boot.
# Strongly recommended in production/Docker so the key is not stored alongside the DB volume.
# Generate via: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# TRACKVAULT_MASTER_KEY=

# Optional client IPv4 forwarded to Netease Cloud Music API when deployed on cloud/overseas hosts
# NETEASE_REAL_IP=

# Upstream media size limits in bytes (cover: 64 KiB..20 MiB; audio download: 1 MiB..512 MiB)
MAX_COVER_BYTES=5242880
MAX_DOWNLOAD_AUDIO_BYTES=262144000

# Global concurrency caps across background workers (1..16)
GLOBAL_MAX_CONCURRENT_DOWNLOADS=6
GLOBAL_MAX_CONCURRENT_JOBS=4

# Upstream platform HTTP request timeout in milliseconds (1000..60000)
UPSTREAM_TIMEOUT_MS=15000
