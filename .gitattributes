# Normalize text files to LF across Windows and Linux
* text=auto eol=lf

# Explicitly enforce LF on source, config, script, and container files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
Dockerfile text eol=lf

# Binary assets, fonts, audio media, databases, and archives
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.flac binary
*.mp3 binary
*.wav binary
*.ogg binary
*.m4a binary
*.aac binary
*.db binary
*.zip binary
