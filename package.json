{
  "name": "trackvault-v2",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#shared": {
      "types": "./packages/shared/src/index.ts",
      "default": "./packages/shared/dist/index.js"
    },
    "#audio-tags": {
      "types": "./packages/audio-tags/src/index.ts",
      "default": "./packages/audio-tags/dist/index.js"
    }
  },
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run build:packages && tsx watch apps/server/src/index.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:packages": "tsc -p packages/shared/tsconfig.json && tsc -p packages/audio-tags/tsconfig.json",
    "build:server": "npm run build:packages && tsc -p apps/server/tsconfig.json",
    "build:web": "npm run build:packages && tsc --noEmit -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "build": "npm run build:packages && tsc -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json && vite build --config apps/web/vite.config.ts",
    "typecheck": "npm run build:packages && tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "biome check packages apps",
    "lint:fix": "biome check --write packages apps",
    "test:shared": "tsx --test \"packages/shared/src/**/*.test.ts\"",
    "test:audio-tags": "tsx --test \"packages/audio-tags/src/**/*.test.ts\"",
    "test:server": "npm run build:packages && tsx --test \"apps/server/src/**/*.test.ts\"",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "test": "npm run build:packages && npm run test:shared && npm run test:audio-tags && npm run test:server && npm run test:web",
    "start": "node apps/server/dist/index.js",
    "import:legacy": "npm run build:packages && tsx apps/server/src/cli/import-legacy.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.1.0",
    "@tanstack/react-query": "^5.74.4",
    "fastify": "^5.2.2",
    "lucide-react": "^0.487.0",
    "NeteaseCloudMusicApi": "^4.32.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.1",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  }
}
